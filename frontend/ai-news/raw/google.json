l}],"analytics_properties":{"has_carousel":"no","has_image":"yes","has_audio":"no","has_video":"yes","hero_media_type":"image"},"content_type":"article page","slug":"gemma-4","tags":"topics-gemini-models,products-developer-tools","secondary_tags":"Gemini models","go_live_date_time":"2026-04-02|16:00","days_since_published":51,"content_category":"Announcement","word_count":1144,"summary":"Gemma 4: our most intelligent open models to date, purpose-built for advanced reasoning and agentic workflows.","full_url":"https://blog.google/innovation-and-ai/technology/developers-tools/gemma-4/","url":"/innovation-and-ai/technology/developers-tools/gemma-4/","published":"2026-04-02T16:00:00Z","hero":"https://storage.googleapis.com/gweb-uniblog-publish-prod/images/gemma-4_blog_keyword_header-dar.max-300x300.format-webp.webp","main_hero_image":null,"category":"article","tag":"products-developer-tools","tag_eyebrow":"https://blog.google/innovation-and-ai/technology/developers-tools/","tag_name":"Developer tools","eyebrow":"<time class=\"uni-timesince\" datetime=\"2026-04-02 16:00:00+00:00\" aria-label=\"April 02\">Apr 02</time> / Developer tools","show_byline":true,"sitespace":"","sitespace_render":"","published_node":"<time class=\"uni-timesince\" datetime=\"2026-04-02 16:00:00+00:00\">Apr 02</time>","published_readable_date":"Apr 02","body_text":null,"short_body":null,"footnotes_list":[]},{"page_id":84017,"headline":"The latest AI news we announced in March 2026","author":"The Keyword Team","author_list":[{"display_name":"The Keyword Team","assigned_job_title":null,"image_renditions":null,"author_page":null}],"analytics_properties":{"has_carousel":"no","has_image":"yes","has_audio":"no","has_video":"yes","hero_media_type":"mp4"},"content_type":"article page","slug":"google-ai-updates-march-2026","tags":"search,translate,topics-google-deepmind,products-developer-tools,google-workspace,ai,pixel,products-gemini-app,topics-gemini-models,products-fitbit,maps,health","secondary_tags":"Search,Google Workspace,Maps,Gemini App,Pixel,Translate,Health,Fitbit,Developer tools,Gemini models,Google DeepMind","go_live_date_time":"2026-04-01|13:00","days_since_published":52,"content_category":"Announcement","word_count":1201,"summary":"Here are Google’s latest AI updates from March 2026","full_url":"https://blog.google/innovation-and-ai/technology/ai/google-ai-updates-march-2026/","url":"/innovation-and-ai/technology/ai/google-ai-updates-march-2026/","published":"2026-04-01T13:00:00Z","hero":"https://storage.googleapis.com/gweb-uniblog-publish-prod/images/March_2026_AI_Recap_social_hvvl.max-300x300.format-webp.webp","main_hero_image":null,"category":"article","tag":"ai","tag_eyebrow":"https://blog.google/innovation-and-ai/technology/ai/","tag_name":"AI","eyebrow":"<time class=\"uni-timesince\" datetime=\"2026-04-01 13:00:00+00:00\" aria-label=\"April 01\">Apr 01</time> / AI","show_byline":true,"sitespace":"","sitespace_render":"","published_node":"<time class=\"uni-timesince\" datetime=\"2026-04-01 13:00:00+00:00\">Apr 01</time>","published_readable_date":"Apr 01","body_text":null,"short_body":null,"footnotes_list":[]},{"page_id":84018,"headline":"Improve coding agents’ performance with Gemini API Docs MCP and Agent Skills.","author":"Trey Nguyen","author_list":[{"display_name":"Trey Nguyen","assigned_job_title":"Product Manager, Google DeepMind","image_renditions":null,"author_page":null}],"analytics_properties":{"has_carousel":"no","has_image":"yes","has_audio":"no","has_video":"no","hero_media_type":"none"},"content_type":"Short Post","slug":"gemini-api-docsmcp-agent-skills","tags":"products-developer-tools","secondary_tags":null,"go_live_date_time":"2026-04-01|12:54","days_since_published":52,"content_category":null,"word_count":0,"summary":"Agents can generate outdated Gemini API code because their training data has a cutoff date. We built two complementary tools to fix this.Th…","full_url":"https://blog.google/innovation-and-ai/technology/developers-tools/gemini-api-docsmcp-agent-skills/","url":"/innovation-and-ai/technology/developers-tools/gemini-api-docsmcp-agent-skills/","published":"2026-04-01T12:54:00Z","hero":"https://storage.googleapis.com/gweb-uniblog-publish-prod/images/gemini-api-skills-mcp.max-300x300.format-webp.webp","main_hero_image":null,"category":"short-post","tag":"products-developer-tools","tag_eyebrow":"https://blog.google/innovation-and-ai/technology/developers-tools/","tag_name":"Developer tools","eyebrow":"<time class=\"uni-timesince\" datetime=\"2026-04-01 12:54:00+00:00\" aria-label=\"April 01\">Apr 01</time> / Developer tools","show_byline":null,"sitespace":"","sitespace_render":"","published_node":"<time class=\"uni-timesince\" datetime=\"2026-04-01 12:54:00+00:00\">Apr 01</time>","published_readable_date":"Apr 01","body_text":"<div class=\"rich-text\"><p data-block-key=\"s5iup\">Agents can generate outdated Gemini API code because their training data has a cutoff date. We built two complementary tools to fix this.</p><p data-block-key=\"dmu61\">The <a href=\"https://ai.google.dev/gemini-api/docs/coding-agents#mcp-setup\">Gemini API Docs MCP</a> (https://gemini-api-docs-mcp.dev) connects your coding agent to the current Gemini API documentation, SDKs and model information via the Model Context Protocol. This ensures that your coding agent has access to the most up-to-date APIs and code and builds with the most optimal configuration settings.</p><p data-block-key=\"84lkk\">The <a href=\"https://ai.google.dev/gemini-api/docs/coding-agents#available-skills\">Gemini API Developer Skills</a> adds best-practice instructions, resources-links and patterns to guide the agent toward current SDK patterns.</p><p data-block-key=\"49fut\">While each tool independently improves your workflow, using them together unlocks their full potential. Our evals show that combining MCP and Skills leads to a 96.3% pass rate on our eval set, with 63% fewer tokens per correct answer compared to vanilla prompting. Set up both at <a href=\"https://ai.google.dev/gemini-api/docs/coding-agents\">ai.google.dev/gemini-api/docs/coding-agents</a>.</p></div>","short_body":[{"type":"image_full_width","value":{"image":{"hosted":{"id":66244,"renditions":{"small":{"url":"https://storage.googleapis.com/gweb-uniblog-publish-prod/images/gemini-api-skills-mcp.max-100x100.format-webp.webp","full_url":"https://storage.googleapis.com/gweb-uniblog-publish-prod/images/gemini-api-skills-mcp.max-100x100.format-webp.webp","width":100,"height":82,"alt":"gemini-api-skills-mcp"},"small_retina":{"url":"https://storage.googleapis.com/gweb-uniblog-publish-prod/images/gemini-api-skills-mcp.max-200x200.format-webp.webp","full_url":"https://storage.googleapis.com/gweb-uniblog-publish-prod/images/gemini-api-skills-mcp.max-200x200.format-webp.webp","width":200,"height":164,"alt":"gemini-api-skills-mcp"},"medium":{"url":"https://storage.googleapis.com/gweb-uniblog-publish-prod/images/gemini-api-skills-mcp.max-500x500.format-webp.webp","full_url":"https://storage.googleapis.com/gweb-uniblog-publish-prod/images/gemini-api-skills-mcp.max-500x500.format-webp.webp","width":500,"height":410,"alt":"gemini-api-skills-mcp"},"medium_retina":{"url":"https://storage.googleapis.com/gweb-uniblog-publish-prod/images/gemini-api-skills-mcp.max-1000x1000.format-webp.webp","full_url":"https://storage.googleapis.com/gweb-uniblog-publish-prod/images/gemini-api-skills-mcp.max-1000x1000.format-webp.webp","width":1000,"height":821,"alt":"gemini-api-skills-mcp"},"large":{"url":"https://storage.googleapis.com/gweb-uniblog-publish-prod/images/gemini-api-skills-mcp.max-1000x1000.format-webp.webp","full_url":"https://storage.googleapis.com/gweb-uniblog-publish-prod/images/gemini-api-skills-mcp.max-1000x1000.format-webp.webp","width":1000,"height":821,"alt":"gemini-api-skills-mcp"},"large_retina":{"url":"https://storage.googleapis.com/gweb-uniblog-publish-prod/images/gemini-api-skills-mcp.max-2000x2000.format-webp.webp","full_url":"https:/