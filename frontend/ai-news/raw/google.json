0:00\">Apr 21</time>","published_readable_date":"Apr 21","body_text":null,"short_body":null,"footnotes_list":[]},{"page_id":84207,"headline":"Start vibe coding in AI Studio with your Google AI subscription.","author":"Seth Odoom","author_list":[{"display_name":"Seth Odoom","assigned_job_title":"Product Manager, Google AI Studio","image_renditions":null,"author_page":null}],"analytics_properties":{"has_carousel":"no","has_image":"yes","has_audio":"no","has_video":"yes","hero_media_type":"none"},"content_type":"Short Post","slug":"google-one-ai-studio","tags":"google-one,products-bard,products-developer-tools","secondary_tags":"Gemini,Google One","go_live_date_time":"2026-04-20|16:32","days_since_published":51,"content_category":null,"word_count":0,"summary":"Starting today, Google AI Pro and Ultra subscribers get increased usage limits in Google AI Studio. This update also includes access to Nan…","full_url":"https://blog.google/innovation-and-ai/technology/developers-tools/google-one-ai-studio/","url":"/innovation-and-ai/technology/developers-tools/google-one-ai-studio/","published":"2026-04-20T16:32:00Z","hero":"https://storage.googleapis.com/gweb-uniblog-publish-prod/images/g1-ais_keyword_DEV_header_dark.max-300x300.format-webp.webp","main_hero_image":null,"category":"short-post","tag":"products-developer-tools","tag_eyebrow":"https://blog.google/innovation-and-ai/technology/developers-tools/","tag_name":"Developer tools","eyebrow":"<time class=\"uni-timesince\" datetime=\"2026-04-20 16:32:00+00:00\" aria-label=\"April 20\">Apr 20</time> / Developer tools","show_byline":null,"sitespace":"","sitespace_render":"","published_node":"<time class=\"uni-timesince\" datetime=\"2026-04-20 16:32:00+00:00\">Apr 20</time>","published_readable_date":"Apr 20","body_text":"<div class=\"rich-text\"><p data-block-key=\"wppl4\">Starting today, <a href=\"https://one.google.com/about/google-ai-plans/\">Google AI Pro and Ultra</a> subscribers get increased usage limits in <a href=\"https://aistudio.google.com/\">Google AI Studio</a>. This update also includes access to Nano Banana Pro and Gemini Pro models, providing developers with more versatility right out of the gate. Subscribers can now move from an initial idea to a working application in minutes with predictable costs.</p><p data-block-key=\"53tn3\">For builders who have exhausted their free-tier limits, a <a href=\"https://one.google.com/ai?utm_source=ai_studio\">Google AI plan</a> now serves as a low-setup billing bridge. While pay-per-request API keys remain the standard for production-scale launches, these subscriber benefits offer an easy entry point to developers who would like to experiment and prototype more deeply with AI Studio. When you’re ready to launch, transitioning to an API setup is easily handled within AI Studio.</p><p data-block-key=\"3todu\">These benefits are rolling out now to all AI Pro and Ultra subscribers. Sign in with your linked account to <a href=\"http://aistudio.google.com/apps\">start building today</a>.</p></div>","short_body":[{"type":"image_full_width","value":{"image":{"hosted":null,"or_mp4_video":{"id":4412,"url":"https://storage.googleapis.com/gweb-uniblog-publish-prod/original_videos/G1_v6_1920x1080.mp4","title":"Start vibing v2","tracks":[],"autoplay":false},"audio_description_video":null,"or_external":{"url":""}},"alt_text":"A video showing examples of what can be built in Google AI Studio.","link":{"internal":null,"external":""},"caption":"<div class=\"rich-text\"></div>","alignment":"full"},"id":"c7fe6186-f143-499a-99bb-f99d7eb1e72a"}],"footnotes_list":[]}]}